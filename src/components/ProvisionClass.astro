---
import XrefList from './XrefList.astro'

interface XrefItem {
  id: string
  kind: string
}

interface Props {
  page: {
    title: string
    page_type: 'requirements_class' | 'conformance_class' | 'requirement' | 'test'
    identifier: string
    uri_base: string
    parent_identifier?: string
    standard_title: string
    data: Record<string, any>
    xrefs: Record<string, any>
    iso_standard_url?: string
    iso_preview_url?: string
  }
}
const { page } = Astro.props
const { page_type, identifier, uri_base: uriBase, data, xrefs } = page

const badgeByType: Record<string, { cls: string; label: string }> = {
  requirements_class: { cls: 'req', label: 'Requirements Class' },
  conformance_class: { cls: 'conf', label: 'Conformance Class' },
  requirement: { cls: 'req', label: 'Requirement' },
  test: { cls: 'conf', label: 'Conformance Test' },
}
const badge = badgeByType[page_type]

const children: { identifier_fragment: string; name: string }[] | undefined =
  data.requirements ?? data.tests
const childrenTitle = page_type === 'requirements_class' ? 'Requirements' : 'Conformance Tests'
const childrenEmpty =
  page_type === 'requirements_class'
    ? 'This class has no individual requirements. It aggregates dependencies to other requirements classes.'
    : 'This class has no individual conformance tests. It aggregates dependencies to other conformance classes.'
---

<div class={`content-page provision-page provision-page--${page_type}`}>
  <header class="content-page__header">
    <nav class="content-page__breadcrumb">
      <a href="/">Home</a>{' › '}
      <a href={`/${uriBase.split('/')[0]}/`}>ISO {uriBase.split('/')[0]}</a>
      {page.parent_identifier && (
        <>
          {' › '}
          <a href={`/${uriBase}${page.parent_identifier}/`}>{page.parent_identifier}</a>
        </>
      )}
    </nav>

    <h1 class="content-page__title">{page.title}</h1>

    <div class="provision-meta">
      <span class={`provision-badge provision-badge--${badge.cls}`}>{badge.label}</span>
      {page.iso_standard_url && (
        <span class="provision-iso-links">
          <a href={page.iso_standard_url} target="_blank" rel="noopener" class="provision-iso-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" class="provision-iso-link__icon">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
            </svg>
            ISO.org
          </a>
          {page.iso_preview_url && (
            <a href={page.iso_preview_url} target="_blank" rel="noopener" class="provision-iso-link">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" class="provision-iso-link__icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
              </svg>
              Preview
            </a>
          )}
        </span>
      )}
    </div>
  </header>

  <div class="provision-content">
    <div class="provision-field">
      <div class="provision-field__label">Identifier</div>
      <div class="provision-field__value">
        <code class="provision-uri">https://standards.isotc211.org/{uriBase}{identifier}</code>
      </div>
    </div>

    {page_type === 'conformance_class' && xrefs.requirements_class && (
      <div class="provision-field">
        <div class="provision-field__label">Requirements class</div>
        <div class="provision-field__value">
          <a href={`/${uriBase}${xrefs.requirements_class}`} class="provision-xref-link">
            <span class="provision-xref-badge provision-xref-badge--req">req class</span>
            {xrefs.requirements_class}
          </a>
        </div>
      </div>
    )}

    {page_type === 'requirements_class' && xrefs.tested_by && xrefs.tested_by.length > 0 && (
      <div class="provision-field">
        <div class="provision-field__label">Tested by</div>
        <div class="provision-field__value">
          <ul class="provision-xref-list">
            {xrefs.tested_by.map((confId: string) => (
              <li>
                <a href={`/${uriBase}${confId}`} class="provision-xref-link">
                  <span class="provision-xref-badge provision-xref-badge--conf">conf class</span>
                  {confId}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {data.subject && (
      <div class="provision-field">
        <div class="provision-field__label">Subject</div>
        <div class="provision-field__value">{data.subject}</div>
      </div>
    )}

    {data.description && (
      <div class="provision-field">
        <div class="provision-field__label">Description</div>
        <div class="provision-field__value">{data.description}</div>
      </div>
    )}

    {(page_type === 'requirement' || page_type === 'test') && xrefs.tested_by && xrefs.tested_by.length > 0 && (
      <div class="provision-field">
        <div class="provision-field__label">Tested by</div>
        <div class="provision-field__value">
          <XrefList items={xrefs.tested_by} uriBase={uriBase} />
        </div>
      </div>
    )}

    {page_type === 'test' && xrefs.targets && xrefs.targets.length > 0 && (
      <div class="provision-field">
        <div class="provision-field__label">Targets</div>
        <div class="provision-field__value">
          <XrefList items={xrefs.targets} uriBase={uriBase} />
        </div>
      </div>
    )}

    {page_type === 'requirement' &&
      (data.statement ? (
        <div class="provision-field">
          <div class="provision-field__label">Statement</div>
          <div class="provision-field__value provision-statement">{data.statement}</div>
        </div>
      ) : (
        <div class="provision-field">
          <div class="provision-field__label">Statement</div>
          <div class="provision-field__value">
            <div class="provision-statement--redacted">
              Refer to {page.standard_title} for the full requirement statement.
            </div>
          </div>
        </div>
      ))}

    {page_type === 'test' && data.purpose && (
      <div class="provision-field">
        <div class="provision-field__label">Purpose</div>
        <div class="provision-field__value">{data.purpose}</div>
      </div>
    )}

    {page_type === 'test' && data.method && (
      <div class="provision-field">
        <div class="provision-field__label">Method</div>
        <div class="provision-field__value">{data.method}</div>
      </div>
    )}

    {page_type === 'test' && data.type && (
      <div class="provision-field">
        <div class="provision-field__label">Test Type</div>
        <div class="provision-field__value">{data.type}</div>
      </div>
    )}

    {xrefs.dependencies && xrefs.dependencies.length > 0 && (
      <div class="provision-field">
        <div class="provision-field__label">Dependencies</div>
        <div class="provision-field__value">
          <XrefList items={xrefs.dependencies} uriBase={uriBase} />
        </div>
      </div>
    )}

    {data.guidance && data.guidance.length > 0 && (
      <div class="provision-field">
        <div class="provision-field__label">Guidance</div>
        <div class="provision-field__value">
          <ul>
            {data.guidance.map((g: string) => <li>{g}</li>)}
          </ul>
        </div>
      </div>
    )}

    {data.examples && data.examples.length > 0 && (
      <div class="provision-field">
        <div class="provision-field__label">Examples</div>
        <div class="provision-field__value">
          <ul>
            {data.examples.map((e: string) => <li>{e}</li>)}
          </ul>
        </div>
      </div>
    )}

    {(page_type === 'requirements_class' || page_type === 'conformance_class') && (
      <div class={`provision-children provision-children--${page_type}`}>
        <h2 class="provision-children__title">{childrenTitle}</h2>
        {children && children.length > 0 ? (
          <div class="provision-children__list">
            {children.map((child) => (
              <a href={`/${uriBase}${identifier}/${child.identifier_fragment}/`} class={`provision-child-card provision-child-card--${page_type}`}>
                <div class="provision-child-card__name">{child.name}</div>
                <div class="provision-child-card__id">
                  <code>{identifier}/{child.identifier_fragment}</code>
                </div>
                <svg class="provision-child-card__chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                </svg>
              </a>
            ))}
          </div>
        ) : (
          <div class="provision-children__empty">{childrenEmpty}</div>
        )}
      </div>
    )}
  </div>
</div>
